[flake8]
# Line length
max-line-length = 100

# Maximum complexity
max-complexity = 10

# Exclude patterns
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .eggs

# Ignore specific errors
ignore =
    E203,  # whitespace before ':'
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator

# Per-file ignores
per-file-ignores =
    __init__.py:F401

# Select specific error codes to check
select = E,F,W,C90

# Show source code for errors
show-source = True

# Count errors
count = True